    "@tanstack/react-table": "^9.0.0",
    "@vercel/blob": "^2.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.28.0",
    "marked": "^18.0.9",
    "next": "16.3.0",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
