# Copy to .env and fill in real values. .env is gitignored; never commit real credentials.

# Local dev default. In prod (Neon) this looks like:
# postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/invoice_review_portal?schema=public"

AGENTSTUDIO_REST_BASE_URL="https://agents.dyna.ai"
AGENTSTUDIO_FLOW_UUID=""

AGENTSTUDIO_CLIENT_MODE="mock"

# "API Call" publish-platform credentials -- the sole live auth as of the
# 2026-08-09 OCR-mode pivot. See src/lib/agentstudio/client.ts.
AGENTSTUDIO_APICALL_ROBOT_KEY=""
AGENTSTUDIO_APICALL_ROBOT_TOKEN=""
AGENTSTUDIO_APICALL_TENANT_NAME=""
AGENTSTUDIO_APICALL_USERNAME=""

LOCAL_STORAGE_DIR="./.data/uploads"

# Storage driver switch -- "local" (default) needs web + worker to share a
# filesystem; "vercel-blob" is required once web (Vercel) and worker
# (Railway) run on separate hosts. See src/lib/storage/index.ts.
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""
